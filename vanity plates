def main():
    plate = input("Plate: ")
    if is_valid(plate):
        print("Valid")
    else:
        print("Invalid")

def is_valid(s):
    # Rule 1: Be between 2 and 6 characters (inclusive)
    # Rule 2: No non-alphanumeric characters are allowed
    if not (2 <= len(s) <= 6) or not s.isalnum():
        return False
    
    # Rule 3: The first two characters must be letters
    if not s[0:2].isalpha():
        return False
    
    # Rule 4 & 5: The first number cannot be a 0, and letters cannot be placed after numbers
    for i in range(len(s)):
        if s[i].isdigit():
            # If the very first number we encounter is a '0', it's invalid
            if s[i] == '0':
                return False
            # Check the rest of the string: if any character after the first number is a letter, it's invalid
            if not s[i:].isdigit():
                return False
            # Once we find the first number and validate the rest of the string, stop looking
            break
            
    return True

main()
